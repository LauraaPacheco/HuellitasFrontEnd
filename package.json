{
  "name": "huellitas",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma hibrida de adopcion y trazabilidad animal para Cali - UNIAJC",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "web": "npm run dev --workspace=@huellitas/web",
    "web:demo": "npm run dev:demo --workspace=@huellitas/web",
    "mobile": "npm run start --workspace=@huellitas/mobile",
    "build:shared": "npm run build --workspace=@huellitas/shared",
    "build:web": "npm run build --workspace=@huellitas/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run && node tests/catalogos.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && node tests/catalogos.test.mjs",
    "build:web:demo": "npm run build --workspace=@huellitas/web -- --mode demo"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "vitest": "^2.1.9"
  }
}
