# Vacio: el front pide a /api de su mismo origen y el proxy de Vite
# reenvia al backend. Es lo que evita el CORS que el backend no tiene.
VITE_URL_API=

# Dejala en false: la web llama al backend de verdad.
#
# Para revisar pantallas con datos simulados no se edita esto, se levanta
# con `npm run dev:demo` (o `npm run web:demo` desde la raiz), que carga
# .env.demo encima de este archivo. Asi no hay que acordarse de devolver
# la variable a false.
VITE_MODO_DEMO=false

# Sin prefijo VITE_: no llegan al navegador, solo las usa el proxy.
# El tunel de devtunnels y su token cambian cada vez que se reinicia.
URL_API_TUNEL=https://localhost:7296
TUNEL_TOKEN=
